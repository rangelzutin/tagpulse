{
  "name": "@tagpulse/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:db:prepare": "tsx tests/helpers/prepare-test-database.ts",
    "test:integration": "vitest run --passWithNoTests tests/integration",
    "audit:inventory": "tsx src/scripts/audit-inventory.ts",
    "ensure:tagplus-connection": "tsx src/scripts/ensure-tagplus-connection.ts",
    "historical:hustler:blockers": "tsx src/scripts/analyze-hustler-blockers.ts",
    "historical:hustler:entities": "tsx src/scripts/create-hustler-entities.ts",
    "historical:hustler:profile": "tsx src/scripts/profile-hustler-dump.ts",
    "historical:hustler:reconcile": "tsx src/scripts/reconcile-hustler-entities.ts",
    "historical:hustler:sales:import": "tsx src/scripts/import-hustler-sales.ts",
    "historical:hustler:sales:plan": "tsx src/scripts/plan-hustler-sales-import.ts",
    "historical:hustler:sales:reconcile": "tsx src/scripts/reconcile-hustler-sales.ts",
    "historical:hustler:bi:validate": "tsx src/scripts/validate-hustler-commercial-bi.ts",
    "historical:hustler:current:classify": "tsx src/scripts/classify-current-hustler-sales.ts",
    "historical:hustler:current-operation": "tsx src/scripts/persist-current-hustler-operation.ts",
    "historical:hustler:financial:plan": "tsx src/scripts/plan-hustler-financial-import.ts",
    "historical:hustler:stage": "tsx src/scripts/stage-hustler-dump.ts",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@prisma/client": "^6.15.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "zod": "^4.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "prisma": "^6.15.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
